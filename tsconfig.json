{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2022", "DOM", "DOM.Iterable", "esnext"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noImplicitAny": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "wc-compiler",
    "types": ["node"]
  },
  // TODO: add typechecking for SST
  // sst-env.d.ts should be committed
  // https://sst.dev/docs/linking/#generating-types
  "include": ["./src", "./test", "infra", "greenwood.config.ts", "sst-env.d.ts"],
  "exclude": ["./public", "./.greenwood", "./reports", "./.sst", "node_modules"]
}
