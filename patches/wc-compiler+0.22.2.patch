+/**
+ * Transform source files that can contain TypeScript or JSX syntax before Acorn parses them.
+ *
+ * Plain JavaScript dependencies have already been compiled and should be parsed as-is. Passing
+ * those bundles through Sucrase can corrupt otherwise valid JavaScript; for example, inserting a
+ * class-field initializer between a `super()` call and the rest of a comma expression produces an
+ * invalid `;,` token sequence.
+ * 
+ * Current example in this repo:
+ * 
+ * The event details page statically imports `events/server.ts`, so `wc-compiler` recursively parses the bundled Contentful SDK. It fails on generated Contentful code shaped like:
+ *
+ * ```js
+ * super(...), this.linkType = linkType;
+ * ```
+ * 
+ */
+function transformModule(moduleURL, moduleContents) {
+  const extension = moduleURL.pathname.split('.').pop();
+
+  // `.js`, `.mjs`, and `.cjs` modules do not need either of the configured transformations.
+  if (!['jsx', 'ts', 'tsx'].includes(extension)) {
+    return moduleContents;
+  }
+
+  return transform(moduleContents, {
+    transforms: ['typescript', 'jsx'],
+    jsxRuntime: 'automatic',
+    production: true,
+  }).code;
+}
